# OpenAgentic / Gemini API Key
OPENAGENTIC_API_KEY=your_openagentic_api_key_here
OPENAGENTIC_BASE_URL=https://openagentic.id/v1
MODEL_NAME=gemini-3.8-flash-high

# Discord Webhook URL for Trading Signals
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Trading Risk Parameters
MAX_DAILY_LOSS_PCT=5.0
RISK_PER_TRADE_PCT=1.5
MIN_CONFIDENCE_SCORE=0.75
MIN_RISK_REWARD_RATIO=1.5

# Lighter DEX Endpoint Profile (mainnet / testnet)
LIGHTER_PROFILE=mainnet
